# Copy this file to .env and fill in the keys. Every key is optional:
# a sensor whose key is missing says so in the console instead of failing.

# Claude: case explanations (Arabic + English), ad screenshot reading, job-post extraction
ANTHROPIC_API_KEY=
# Model used for explanations and extraction
RASID_MODEL=claude-opus-5-5

# Google Maps Platform key with "Places API (New)" enabled: Maps Verifier sensor
GOOGLE_MAPS_API_KEY=

# SerpAPI key: Ads & Search sweep (Google results from the UAE, per language)
SERPAPI_KEY=

# Optional enrichment
URLSCAN_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=

# Background CT polling of crt.sh for every watchlist term (1 = on)
RASID_CT_POLL=0
RASID_CT_POLL_MINUTES=20
