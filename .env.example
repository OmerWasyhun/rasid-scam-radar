# Copy this file to .env and fill in the keys. Every key is optional:
# a sensor whose key is missing says so in the console instead of failing.

# Claude: case explanations (Arabic + English), ad screenshot reading, job-post extraction
ANTHROPIC_API_KEY=
# Model used for explanations and extraction
RASID_MODEL=claude-opus-5-5

# Google Maps Platform key with "Places API (New)" enabled: Maps Verifier sensor
GOOGLE_MAPS_API_KEY=

# SerpApi key: Google search sweep from the UAE (per language) + Google Ads Transparency Center
SERPAPI_KEY=

# Meta Ad Library API (Facebook, Instagram, Messenger, WhatsApp, Threads ads)
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v27.0

# Reputation (screenshots are taken by RASID's own headless browser, no key needed)
# Google Safe Browsing Lookup API v4 (Google Cloud key with the Safe Browsing API enabled)
GOOGLE_SAFE_BROWSING_KEY=
# VirusTotal v3: how many security vendors flag a domain
VIRUSTOTAL_API_KEY=

# Console login (leave empty to run without a login, e.g. on your own laptop)
RASID_PASSWORD=
RASID_SESSION_SECRET=

# ---------- Call Guardian (voice agent people add to a suspicious call) ----------
# Twilio account (console.twilio.com > Account info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio phone number people add to their call, e.g. +15551234567 (later: a UAE number via e& / du)
RASID_GUARDIAN_NUMBER=
# Sender for the summary SMS; defaults to RASID_GUARDIAN_NUMBER. Can be a registered alphanumeric ID such as RASID
RASID_GUARDIAN_SMS_FROM=
# Public https address of this server that Twilio can reach (ngrok or Cloudflare Tunnel for the demo)
PUBLIC_BASE_URL=
# Language the Guardian listens in first: ar-AE or en-US (press 2 / 3 on the call to switch)
RASID_GUARDIAN_LANG=ar-AE
# Optional: model for the live call analysis (defaults to RASID_MODEL)
RASID_GUARDIAN_MODEL=
# Optional pilot allowlist: comma-separated numbers allowed to use the Guardian (empty = anyone)
RASID_GUARDIAN_ALLOWED=

# Background CT polling of crt.sh for every watchlist term (1 = on)
RASID_CT_POLL=0
RASID_CT_POLL_MINUTES=20
